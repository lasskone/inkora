# =============================================================================
# Inkora — environment variables (TEMPLATE)
#
# This file contains VARIABLE NAMES ONLY with example-safe placeholder values.
# It is safe to commit to version control.
#
# Rules:
#   - Do NOT put real credentials in this file or in any committed file.
#   - Copy this file to ".env" (which is Git-ignored) and fill in real values.
#   - Variables marked "SERVER-ONLY" must never be exposed to frontend code.
#   - Never print secrets or tokens in logs.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL backend)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-ONLY. Never expose to the frontend. Used for privileged server work.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct PostgreSQL connection string used for migrations.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# eBay (OAuth2) — official developer APIs
# -----------------------------------------------------------------------------
# sandbox | production
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
# Space-separated list of OAuth scopes.
EBAY_SCOPE=

# -----------------------------------------------------------------------------
# CJdropshipping — official API
# -----------------------------------------------------------------------------
CJ_API_BASE_URL=
CJ_EMAIL=
CJ_PASSWORD=
# Access token obtained/refreshed by the backend (SERVER-ONLY).
CJ_TOKEN=

# -----------------------------------------------------------------------------
# AI provider — used for narrative explanations ONLY.
# NOTE: AI must never compute authoritative fees, profit, margin, stock or
# opportunity scores (see docs/ARCHITECTURE.md, Fee/Profit/Opportunity engines).
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
