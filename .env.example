# =============================================================================
# Inkora — environment variables (TEMPLATE)
#
# This file contains VARIABLE NAMES ONLY with example-safe placeholder values.
# It is safe to commit to version control.
#
# Rules:
#   - Do NOT put real credentials in this file or in any committed file.
#   - Copy this file to ".env" (which is Git-ignored) and fill in real values.
#   - Variables marked "SERVER-ONLY" must never be exposed to frontend code.
#   - Never print secrets or tokens in logs.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL backend)
# -----------------------------------------------------------------------------
# Public values — safe for the browser. The NEXT_PUBLIC_ prefix exposes them to
# Client Components. The anon key is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never expose to the frontend. Never use the NEXT_PUBLIC_ prefix.
# Bypasses Row Level Security — privileged server work only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct PostgreSQL connection string used for migrations (SERVER-ONLY).
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# eBay (OAuth2) — official developer APIs
# -----------------------------------------------------------------------------
# sandbox | production
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
# Space-separated list of OAuth scopes.
EBAY_SCOPE=

# -----------------------------------------------------------------------------
# CJdropshipping — official API 2.0 (all values SERVER-ONLY)
# -----------------------------------------------------------------------------
# CJ authenticates with an API KEY (not the account sign-in email/password):
# POST /v1/authentication/getAccessToken accepts {"apiKey": "..."} only.
#
# Where to get the key (per CJ's docs): sign in at cjdropshipping.com, then
#   1. Apps → Install App → App Store → "Others" → "API"
#   2. https://www.cjdropshipping.com/my.html#/authorize/API → "API" tab → "Add API"
#   3. Enter an API Key Name, choose "API Key" in the Type dropdown, confirm
# The generated value goes in CJ_API_KEY below. Never commit it.
CJ_API_KEY=
# Optional: pre-obtained access token that seeds the server cache; CJ_API_KEY is
# used to re-authenticate once the cached token is rejected.
CJ_TOKEN=
# Optional override of the official CJ API 2.0 gateway base URL.
CJ_API_BASE_URL=

# -----------------------------------------------------------------------------
# AI provider — used for narrative explanations ONLY.
# NOTE: AI must never compute authoritative fees, profit, margin, stock or
# opportunity scores (see docs/ARCHITECTURE.md, Fee/Profit/Opportunity engines).
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
